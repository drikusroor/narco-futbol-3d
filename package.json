{
  "name": "narco-futbol-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Narco Futbol - fast-paced, server-authoritative 3D arcade soccer for the browser and Discord",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/three": "^0.185.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.1",
    "playwright": "^1.62.1",
    "three": "^0.185.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite": "^7.0.2"
  },
  "optionalDependencies": {
    "@discord/embedded-app-sdk": "^2.5.0"
  }
}
